{
  "name": "ai-ecosystem-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.file.config.js && node scripts/build-portable.mjs",
    "check:data": "npm run validate:data && npm run validate:locations && npm run validate:data-centers && npm run validate:cables && npm run validate:china-fiber && npm run validate:asia-systems && npm run validate:exchanges && npm run validate:model-inference && npm run validate:updates",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:locations": "node scripts/validate-locations.mjs",
    "validate:data-centers": "node scripts/validate-data-centers.mjs",
    "validate:cables": "node scripts/validate-cables.mjs",
    "validate:china-fiber": "node scripts/validate-china-fiber.mjs",
    "validate:asia-systems": "node scripts/validate-asia-systems.mjs",
    "validate:exchanges": "node scripts/validate-exchanges.mjs",
    "validate:model-inference": "node scripts/validate-model-inference.mjs",
    "report:location-coverage": "node scripts/report-location-coverage.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "validate:updates": "node scripts/validate-updates.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^7.1.2"
  }
}
